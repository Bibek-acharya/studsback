# Environment files
.env
.env.*
!.env.example

# Compiled binaries
# Anchored to the repo root on purpose. An unanchored "server" also matches the
# cmd/server/ directory, which silently untracked cmd/server/uploads_test.go.
/server
verify-esewa

# Go build outputs
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Coverage and temporary files
coverage/
coverage.out
tmp/
temp/
scratch/

# Generated files
*.html

# Local databases and runtime files
*.db
*.sqlite
*.sqlite3
*.db-journal
server.log

# Uploaded/generated assets
uploads/

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
# Generated API docs (swagger) are not tracked. The hand-written coin-system
# spec IS, because engineers build from it and it must version with the code it
# describes. Note the two-part form: git cannot re-include a file whose parent
# DIRECTORY is excluded, so /docs/* excludes the entries rather than docs/ itself,
# and the negation then re-admits coin-system.
/docs/*
!/docs/coin-system/

# SDD worktrees (isolated implementation workspaces)
.worktrees/

# SDD review packages (scratch)
.superpowers/
