# Server Configuration
PORT=8080
GIN_MODE=debug

# Database Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRY=24h

# Super Admin Bootstrap (optional)
SUPER_ADMIN_EMAIL=admin@studsphere.com
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_ROLE=super_admin
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Frontend URL (for OAuth callback redirects)
FRONTEND_URL=http://localhost:5173

# Optional cookie domain for production only, e.g. "studsphere.com" or ".studsphere.com".
# Leave empty for localhost/dev.
COOKIE_DOMAIN=

# SMTP Email Configuration (for OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Vector Search (Embedding) Configuration
# Enable: set EMBEDDING_ENABLED=true and provide an OpenAI API key
EMBEDDING_ENABLED=false
# EMBEDDING_API_KEY=sk-your-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# For OpenRouter:  EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# For OpenRouter: EMBEDDING_MODEL=openai/text-embedding-3-small
VECTOR_DIMENSION=1536
EMBEDDING_BATCH_SIZE=20

# Sphere AI (LLM) Configuration
# Enable: set LLM_ENABLED=true and ensure the LLM server is reachable.
# The backend uses an OpenAI-compatible /chat/completions endpoint.
LLM_ENABLED=false
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Use either name. OPENROUTER_API_KEY is preferred for OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-your-key
# LLM_API_KEY=sk-your-key

# File uploads are stored locally under ./uploads and served from /uploads

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=messaging

# Meilisearch Configuration
# Inside Docker network use: http://meilisearch:7700
# For local dev outside Docker use: http://localhost:7700
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=changeme_master_key_12345
MEILI_INDEX_PREFIX=studs_
SEARCH_SYNC_INTERVAL=5s
SEARCH_SYNC_BATCH_SIZE=500
